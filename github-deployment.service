[Unit]
Description=GitHub webhook deployment tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/myapp
EnvironmentFile=/etc/github-deploy/env
ExecStart=/usr/local/bin/github-deployment-tool \
    --repo_name myname/myapp \
    --branch main \
    --build_script /srv/myapp/build.sh \
    --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
